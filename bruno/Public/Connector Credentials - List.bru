meta {
  name: Connector Credentials - List
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/public/v1/connector-credentials
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

docs {
  Lists the workspace's connector credentials, by name, each with its
  connector. Requires the `connectors:manage` ability on the key.

  Stored secret material is not returned.

  Response is wrapped:
  `{ success, statusCode, message, data: { connector_credentials } }`.
}
