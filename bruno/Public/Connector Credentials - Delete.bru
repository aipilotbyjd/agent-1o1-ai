meta {
  name: Connector Credentials - Delete
  type: http
  seq: 28
}

delete {
  url: {{baseUrl}}/public/v1/connector-credentials/:connectorCredential
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

params:path {
  connectorCredential: {{connectorCredentialId}}
}

docs {
  Deletes a connector credential. Requires the `connectors:manage` ability
  on the key. A credential outside the key's workspace answers `404`.

  Nodes still configured to use it will fail to resolve a credential on the
  next run.

  Answers `204 No Content` with no envelope.
}
