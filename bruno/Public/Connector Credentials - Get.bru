meta {
  name: Connector Credentials - Get
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/public/v1/connector-credentials/:connectorCredential
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

params:path {
  connectorCredential: {{connectorCredentialId}}
}

docs {
  Fetches one connector credential with its connector. Requires the
  `connectors:manage` ability on the key. A credential outside the key's
  workspace answers `404`.

  Stored secret material is not returned.

  Response is wrapped:
  `{ success, statusCode, message, data: { connector_credential } }`.
}
