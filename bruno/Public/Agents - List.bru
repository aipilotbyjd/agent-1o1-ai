meta {
  name: Agents - List
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/public/v1/agents
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

script:post-response {
  if (res.status === 200) {
    const agents = res.body.data?.agents;
    if (Array.isArray(agents) && agents.length > 0) {
      bru.setVar("agentId", agents[0].id);
    }
  }
}

docs {
  Lists the API key's workspace's agents, newest first. Requires the
  `agents:invoke` ability on the key.

  This exists for discovery — a caller can't start a session without
  knowing an agent's ID — which is why it sits under `agents:invoke`
  rather than a read scope. Stores the first agent's ID in `agentId`.

  There's no agent CRUD on the Public API: external callers run agents,
  they don't build them.

  Response is wrapped: `{ success, statusCode, message, data: { agents } }`.
}
