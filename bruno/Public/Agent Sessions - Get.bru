meta {
  name: Agent Sessions - Get
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/public/v1/agents/:agent/sessions/:session
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

params:path {
  agent: {{agentId}}
  session: {{agentSessionId}}
}

docs {
  Fetches a session with its message history. Requires the
  `agents:invoke` ability on the key. A session belonging to a different
  agent answers `404`.

  Response is wrapped: `{ success, statusCode, message, data: { session } }`.
}
