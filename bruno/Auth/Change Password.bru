meta {
  name: Change Password
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/auth/change-password
  body: json
  auth: inherit
}

body:json {
  {
    "current_password": "Password123!",
    "password": "NewPassword123!",
    "password_confirmation": "NewPassword123!",
    "revoke_other_sessions": false
  }
}

docs {
  Changes the authenticated user's password. `password` must be
  confirmed and meet the password policy. `revoke_other_sessions`
  (optional boolean) revokes every other active session.

  Responds `204 No Content` with no envelope.
}
