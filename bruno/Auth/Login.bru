meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "jane.doe@example.com",
    "password": "Password123!"
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.body.data ?? {};
    if (data.two_factor_challenge) {
      bru.setVar("challengeToken", data.two_factor_challenge);
    } else {
      bru.setVar("accessToken", data.tokens?.access_token);
    }
  }
}

docs {
  Exchanges email/password for the user plus an access token. Rate
  limited by the `auth` throttle. Stores `accessToken` for use by
  subsequent requests.

  The refresh token is **not** in the body: it is set as an httpOnly,
  Secure `refresh_token` cookie (30 days), which Bruno's cookie jar
  keeps and `Refresh Token` sends back.

  If the account has two-factor authentication enabled, this instead
  returns `data: { "two_factor_challenge": "<token>" }` (no tokens yet)
  and stores it as `challengeToken` — run `2FA - Verify` next to
  complete login.

  Response is wrapped:
  `{ success, statusCode, message, data: { user, tokens: { token_type, expires_in, access_token } } }`.
}
