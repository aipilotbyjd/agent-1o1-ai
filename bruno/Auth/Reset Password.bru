meta {
  name: Reset Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "email": "jane.doe@example.com",
    "password": "NewPassword123!",
    "password_confirmation": "NewPassword123!"
  }
}

docs {
  Completes a password reset using the token emailed by
  `Forgot Password`. Set `resetToken` from that email/link before running.
}
