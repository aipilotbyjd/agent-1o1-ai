meta {
  name: 2FA - Enable
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/v1/auth/2fa/enable
  body: none
  auth: inherit
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("twoFactorSecret", res.body.secret);
  }
}

docs {
  Generates a new TOTP secret and QR code URL (`otpauth://`) for the
  authenticated user. Scan `otpauth_url` with an authenticator app, then
  call `2FA - Confirm` with a generated code to finish enabling.
  Re-running this replaces any unconfirmed secret.
}
