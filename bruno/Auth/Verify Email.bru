meta {
  name: Verify Email
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/auth/verify-email/:id/:hash
  body: none
  auth: none
}

params:path {
  id: 1
  hash: replace-with-signed-hash
}

docs {
  Verifies a user's email address. This is a Laravel signed URL — `id`,
  `hash`, and the required `signature`/`expires` query parameters must be
  copied from the verification email link exactly; it cannot be
  constructed by hand.
}
