meta {
  name: List Sessions
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/v1/auth/sessions
  body: none
  auth: inherit
}

docs {
  Lists the authenticated user's active token sessions, each with the IP
  address, user agent and `last_used_at` it was last seen on, plus
  `is_current` so the caller can label — and warn before revoking — the
  session it is holding.
}
