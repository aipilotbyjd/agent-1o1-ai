meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Jane Doe",
    "email": "jane.doe@example.com",
    "password": "Password123!",
    "password_confirmation": "Password123!"
  }
}

script:post-response {
  if (res.status === 201) {
    const tokens = res.body.tokens ?? {};
    bru.setVar("accessToken", tokens.access_token);
    bru.setVar("refreshToken", tokens.refresh_token);
  }
}

docs {
  Creates a new user account and returns the user plus an access/refresh
  token pair. Requires email uniqueness and a confirmed password meeting
  the app's password policy.
}
