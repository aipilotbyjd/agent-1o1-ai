meta {
  name: Redirect to Provider
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/auth/social/:provider/redirect
  body: none
  auth: none
}

params:path {
  provider: google
}

docs {
  Returns the provider's OAuth authorize URL for the frontend to send the
  browser to (stateless — no session). `provider` must be `google` or
  `github` (any other value is a 404).

  Response is wrapped: `{ success, statusCode, message, data: { url } }`.
}
