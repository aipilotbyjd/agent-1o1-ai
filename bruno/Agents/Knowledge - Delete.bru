meta {
  name: Knowledge - Delete
  type: http
  seq: 46
}

delete {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/knowledge/:knowledge
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
  knowledge: {{knowledgeId}}
}

docs {
  Deletes a knowledge entry. Requires `agent.manage`. Returns 204.
}
