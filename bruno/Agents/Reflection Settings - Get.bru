meta {
  name: Reflection Settings - Get
  type: http
  seq: 47
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/reflection-settings
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
}

docs {
  Fetches whether/how this agent periodically reviews its own past sessions.
  Requires the `agent.view` permission. Creates the settings row with
  defaults on first access if it doesn't exist yet (disabled, review-queue
  apply behavior, nightly cron).

  Response is wrapped: `{ success, statusCode, message, data: { settings } }`.
}
