meta {
  name: Tool Bindings - List
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/tool-bindings
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
}

docs {
  Lists the workflow nodes exposed to this agent as callable tools.
  Requires the `agent.view` permission.

  Response is wrapped: `{ success, statusCode, message, data: { tool_bindings } }`.
}
