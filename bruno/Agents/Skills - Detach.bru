meta {
  name: Skills - Detach
  type: http
  seq: 38
}

delete {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/skills/:skill
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
  skill: {{skillId}}
}

docs {
  Detaches a skill from the agent. The skill itself is not deleted.
  Requires the `agent-skill.manage` permission.

  Responds `204 No Content` with no envelope.
}
