meta {
  name: Eval Suites - Update
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/eval-suites/:suite
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
  suite: {{evalSuiteId}}
}

body:json {
  {
    "name": "Refund policy regressions (v2)"
  }
}

docs {
  Renames a suite or edits its description. Requires the `agent.manage`
  permission. Both fields are `sometimes` — send only what changes.

  Cases are managed separately through the `Eval Cases` requests.

  Response is wrapped: `{ success, statusCode, message, data: { suite } }`.
}
