meta {
  name: Tool Bindings - Delete
  type: http
  seq: 32
}

delete {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/tool-bindings/:toolBinding
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
  toolBinding: {{toolBindingId}}
}

docs {
  Removes a tool binding from the agent. Requires the `agent.manage`
  permission. A binding belonging to a different agent answers `404`.

  Responds `204 No Content` with no envelope.
}
