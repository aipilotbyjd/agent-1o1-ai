meta {
  name: Session Evaluations - Get
  type: http
  seq: 59
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/session-evaluations/:evaluation
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
  evaluation: {{sessionEvaluationId}}
}

docs {
  Fetches one session evaluation: grade, sentiment, summary, per-criterion
  results with rationale, extracted data points, and applied tags.
  Requires the `agent.view` permission. An evaluation belonging to a
  different agent answers `404`.

  Response is wrapped:
  `{ success, statusCode, message, data: { evaluation } }`.
}
