meta {
  name: Memories - Delete
  type: http
  seq: 22
}

delete {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/memories/:memory
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
  memory: {{memoryId}}
}

docs {
  Deletes a memory. Requires the `agent.manage` permission. A memory
  belonging to a different agent answers `404`.

  Responds `204 No Content` with no envelope.
}
