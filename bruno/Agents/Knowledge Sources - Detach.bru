meta {
  name: Knowledge Sources - Detach
  type: http
  seq: 63
}

delete {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/knowledge-sources/:collection
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
  collection: {{knowledgeCollection}}
}

docs {
  Detaches a collection from this agent. Requires `agent.manage`. Detaching
  one that isn't attached is a no-op. Returns 204.

  This never deletes the collection or its chunks — only the agent's
  ability to search it. Delete the data itself with `Knowledge Base -
  Delete Collection`.
}
