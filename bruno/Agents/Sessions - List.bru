meta {
  name: Sessions - List
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/sessions
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
}

docs {
  Lists the agent's top-level chat sessions (subagent sessions are
  excluded), newest first, each with `messages_count` and
  `pending_actions_count`. Requires the `agent.view` permission.

  Response is wrapped: `{ success, statusCode, message, data: { sessions } }`.
}
