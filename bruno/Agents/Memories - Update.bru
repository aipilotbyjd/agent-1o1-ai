meta {
  name: Memories - Update
  type: http
  seq: 21
}

patch {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/memories/:memory
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
  memory: {{memoryId}}
}

body:json {
  {
    "value": "green"
  }
}

docs {
  Updates a memory. All fields (`key`, `value`, `type`, `metadata`) are
  optional. Requires the `agent.manage` permission. A memory belonging to
  a different agent answers `404`.

  Response is wrapped: `{ success, statusCode, message, data: { memory } }`.
}
