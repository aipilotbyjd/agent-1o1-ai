meta {
  name: Subagents - List
  type: http
  seq: 78
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/subagents
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
}

docs {
  Lists the agents this agent may delegate to as subagents. Requires the
  `agent.view` permission.

  Response is wrapped: `{ success, statusCode, message, data: { subagents } }`.
}
