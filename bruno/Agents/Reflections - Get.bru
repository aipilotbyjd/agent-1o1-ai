meta {
  name: Reflections - Get
  type: http
  seq: 53
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/reflections/:reflection
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
  reflection: {{reflectionId}}
}

docs {
  Fetches one proposed improvement, including its rationale, confidence,
  supporting session count, and the exact instructions text it proposes to
  apply. Requires the `agent.view` permission. A reflection belonging to a
  different agent answers `404`.

  Response is wrapped: `{ success, statusCode, message, data: { reflection } }`.
}
