meta {
  name: Agents - Get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
}

docs {
  Fetches a single agent. Requires the `agent.view` permission.

  Response is wrapped: `{ success, statusCode, message, data: { agent } }`.
}
