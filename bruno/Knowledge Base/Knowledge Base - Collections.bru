meta {
  name: Knowledge Base - Collections
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/knowledge-base/collections
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's collections with their chunk counts — derived from
  the stored chunks, since a collection is just a string column. Requires
  `agent.view`.

  Response is wrapped: `{ ..., data: { collections } }`.
}
