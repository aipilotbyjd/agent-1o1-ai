meta {
  name: Api Keys - List
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/api-keys
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists API keys for the workspace (hashed keys only). Requires the
  `api-key.view` permission.
}
