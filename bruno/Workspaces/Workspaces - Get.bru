meta {
  name: Workspaces - Get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Shows a single workspace, with workflow/agent counts and the caller's
  role in it. Requires the `workspace.view` permission.

  Response is wrapped: `{ success, statusCode, message, data: { workspace } }`.
}
