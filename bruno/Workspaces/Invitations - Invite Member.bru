meta {
  name: Invitations - Invite Member
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/invitations
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

body:json {
  {
    "email": "new.member@example.com",
    "role": "member"
  }
}

script:post-response {
  if (res.status === 201) {
    const invitation = res.body.data?.invitation ?? {};
    if (invitation.id) {
      bru.setVar("invitationId", invitation.id);
    }
  }
}

docs {
  Invites a user to the workspace by email with an assignable role.
  Requires the `member.invite` permission.

  Response is wrapped: `{ success, statusCode, message, data: { invitation } }`.
}
