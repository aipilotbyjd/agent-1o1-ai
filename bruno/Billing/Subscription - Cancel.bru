meta {
  name: Subscription - Cancel
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/billing/subscription/cancel
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Cancels the workspace's subscription at the end of the current billing
  period. Requires the `billing.manage` permission. Returns `404` when the
  workspace has no active subscription.

  Response is wrapped: `{ success, statusCode, message, data: { subscription } }`.
}
