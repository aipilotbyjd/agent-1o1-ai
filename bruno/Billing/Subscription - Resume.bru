meta {
  name: Subscription - Resume
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/billing/subscription/resume
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Resumes a subscription that was previously canceled (before the end of
  its billing period). Requires the `billing.manage` permission. `404` if
  the workspace has no subscription, `422` if it isn't on its grace period.

  Response is wrapped: `{ success, statusCode, message, data: { subscription } }`.
}
