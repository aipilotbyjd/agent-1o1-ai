meta {
  name: Connector Credentials - Delete
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/v1/workspaces/:workspace/connector-credentials/:connectorCredential
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  connectorCredential: {{connectorCredentialId}}
}

params:query {
  ~replace_with: replace-with-credential-id
}

docs {
  Deletes a connector credential (soft delete). Requires the
  `connector.manage` permission; a colleague's personal credential is a
  404.

  - `replace_with` — optional credential UUID visible to the caller.
    Everything pinned to this credential is moved to that one first
    (see `Connector Credentials - Usage`), so nothing that used it
    breaks; 404 if it isn't found. Recorded in the audit log.

  Responds `204 No Content` with no envelope.
}
