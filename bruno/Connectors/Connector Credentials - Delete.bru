meta {
  name: Connector Credentials - Delete
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/v1/workspaces/:workspace/connector-credentials/:connectorCredential
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  connectorCredential: {{connectorCredentialId}}
}

docs {
  Deletes a connector credential (soft delete). Requires the
  `connector.manage` permission.

  Responds `204 No Content` with no envelope.
}
