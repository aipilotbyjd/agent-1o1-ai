meta {
  name: Connector Credentials - List
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/connector-credentials
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's stored connector credentials (name/expiry
  metadata only — never the decrypted secret), ordered by name. Requires
  the `connector.view` permission.

  Only credentials *visible to the caller* are returned: every `team`
  credential, plus the caller's own `personal` ones. A colleague's
  `personal` credential never appears here, or on `- Get`/`- Update`/
  `- Delete` (404, not 403 — hidden, not merely forbidden).

  Response is wrapped:
  `{ success, statusCode, message, data: { connector_credentials } }`.
}
