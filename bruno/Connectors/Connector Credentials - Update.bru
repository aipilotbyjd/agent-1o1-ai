meta {
  name: Connector Credentials - Update
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/v1/workspaces/:workspace/connector-credentials/:connectorCredential
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  connectorCredential: {{connectorCredentialId}}
}

body:json {
  {
    "name": "New name"
  }
}

docs {
  Updates a connector credential. All fields (`name`, `data`,
  `expires_at`) are optional. Requires the `connector.manage` permission,
  and — for a `personal` credential — that the caller is its creator (a
  colleague's personal credential 404s, not 403).

  `scope` and `is_default` aren't editable here: scope is fixed at
  creation, and defaults are changed via
  `Connector Credentials - Set Default`.

  Response is wrapped:
  `{ success, statusCode, message, data: { connector_credential } }`.
}
