meta {
  name: Connector Credentials - Create
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/connector-credentials
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

body:json {
  {
    "connector_id": {{connectorId}},
    "name": "My API Key",
    "data": {
      "api_key": "sk_test_secret"
    },
    "expires_at": null,
    "scope": "team",
    "is_default": false
  }
}

script:post-response {
  if (res.status === 201) {
    const credential = res.body.data?.connector_credential;
    if (credential && credential.id) {
      bru.setVar("connectorCredentialId", credential.id);
    }
  }
}

docs {
  Manually stores a credential (`api_key`/`bearer_token`/`basic_auth`) for
  a non-OAuth connector. Requires the `connector.manage` permission.

  Rejects (422) connectors whose `auth_type` is `oauth2` — use
  `Connector Credentials - OAuth Initiate` instead. `data`'s shape must
  match the target connector's `fields` schema; it's encrypted at rest
  and never returned in responses. Stores the new id as
  `connectorCredentialId`.

  - `scope` — optional, `team` (default, workspace-shared) or `personal`.
    A `personal` credential is owned by the caller and invisible to every
    other workspace member, including admins — Gumloop's "Privacy
    guaranteed" Personal Connectors.
  - `is_default` — optional. When true, becomes the credential a
    node/agent gets when nothing pins a `credential_id` for this
    connector, unsetting any previous default in the same
    (connector, scope[, creator]) group. Same as calling
    `Connector Credentials - Set Default` right after.

  Response is wrapped:
  `{ success, statusCode, message, data: { connector_credential } }`.
}
