meta {
  name: Connector Credentials - Get
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/connector-credentials/:connectorCredential
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  connectorCredential: {{connectorCredentialId}}
}

docs {
  Fetches a single connector credential (metadata only, never `data`).
  Requires the `connector.view` permission. 404s for a credential
  belonging to another workspace.

  Response is wrapped:
  `{ success, statusCode, message, data: { connector_credential } }`.
}
