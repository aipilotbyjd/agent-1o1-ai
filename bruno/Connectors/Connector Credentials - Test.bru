meta {
  name: Connector Credentials - Test
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/connector-credentials/:connectorCredential/test
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  connectorCredential: {{connectorCredentialId}}
}

docs {
  Checks the connection works right now and records the result on the
  credential (`last_tested_at`, `last_test_ok`, `last_test_message`,
  `account_label`). Requires `connector.manage`; a colleague's personal
  credential is a 404. Throttled to 10/minute (`connector-tests`).

  A failed check is a result, not an error: 200 either way, with
  `result.ok` saying which.

  Response is wrapped:
  `{ success, statusCode, message, data: { result: { ok, message, account, tested_at }, connector_credential } }`.
}
