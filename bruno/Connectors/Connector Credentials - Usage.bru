meta {
  name: Connector Credentials - Usage
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/connector-credentials/:connectorCredential/usage
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  connectorCredential: {{connectorCredentialId}}
}

docs {
  The workflows, agents and knowledge sources that would stop working if
  this credential were disconnected — show it before a delete, and pass
  a replacement as `replace_with` on `Connector Credentials - Delete`.
  Requires `connector.view`; a colleague's personal credential is a 404.

  `via` is `pinned` (explicit `credential_id`) or `default` (picked up
  as the default for unpinned nodes/tools).

  Response is wrapped:
  `{ success, statusCode, message, data: { usage: { is_default_for_unpinned, workflows: [{ id, name, nodes_count, via }], agents: [{ id, name, tools_count, via }], knowledge_sources: [{ id, name }], total } } }`.
}
