meta {
  name: Secrets - Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/secrets
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

body:json {
  {
    "key": "API_TOKEN",
    "value": "replace-me",
    "description": "Token used by the HTTP node.",
    "is_secret": true
  }
}

script:post-response {
  if (res.status === 201) {
    const secret = res.body.data?.secret;
    if (secret && secret.id) {
      bru.setVar("secretId", secret.id);
    }
  }
}

docs {
  Creates a secret or a plain variable. Requires the `secret.manage`
  permission. Stores the new ID in the `secretId` collection variable.

  - `key` — required, must match `^[A-Z][A-Z0-9_]*$` (uppercase letters,
    digits and underscores, starting with a letter). It's constrained to
    that charset because anything else can't be referenced from a node
    config's `{{ }}` expression. Unique per workspace.
  - `value` — required, max 16384 characters.
  - `description` — optional, max 255 characters.
  - `is_secret` — optional boolean. `true` (a secret) makes the value
    write-only; `false` stores a plain variable whose value is readable
    back through this API.

  Response is wrapped: `{ success, statusCode, message, data: { secret } }`.
}
