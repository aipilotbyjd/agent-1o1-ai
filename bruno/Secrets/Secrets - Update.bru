meta {
  name: Secrets - Update
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/workspaces/:workspace/secrets/:secret
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  secret: {{secretId}}
}

body:json {
  {
    "value": "replace-me-rotated",
    "description": "Rotated token used by the HTTP node."
  }
}

docs {
  Updates a secret. Requires the `secret.manage` permission. Every field is
  `sometimes` — send only what changes.

  `key`, `value`, `description` and `is_secret` follow the same rules as
  `Secrets - Create`, and `key` stays unique per workspace.

  One extra rule: flipping `is_secret` from `true` to `false` requires a new
  `value` in the same request. Otherwise converting a secret to a readable
  variable would become the read-back path the API deliberately doesn't
  offer, and it answers `422`.

  Response is wrapped: `{ success, statusCode, message, data: { secret } }`.
}
