meta {
  name: Secrets - List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/secrets
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's secrets and plain variables, ordered by `key`.
  Requires the `secret.view` permission.

  Entries with `is_secret: true` come back without a `value` — a secret's
  value is write-only and no endpoint or permission reads it back. Plain
  variables (`is_secret: false`) do include `value`.

  Each entry carries a `reference` string (`{{ secrets.KEY }}`) — that's
  the token you paste into a node config to use it.

  Response is wrapped: `{ success, statusCode, message, data: { secrets } }`.
}
