meta {
  name: Secrets - Delete
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/v1/workspaces/:workspace/secrets/:secret
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  secret: {{secretId}}
}

docs {
  Deletes a secret. Requires the `secret.manage` permission.

  Answers `204 No Content` with no envelope. Node configs still holding a
  `{{ secrets.KEY }}` reference are not rewritten — they'll fail to resolve
  on the next run.
}
