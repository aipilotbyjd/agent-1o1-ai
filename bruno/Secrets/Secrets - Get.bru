meta {
  name: Secrets - Get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/secrets/:secret
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  secret: {{secretId}}
}

docs {
  Fetches a single secret's metadata. Requires the `secret.view`
  permission. A secret from another workspace answers `404`.

  `value` is omitted when `is_secret` is true — use `Secrets - Update` to
  replace the value rather than trying to read it.

  Response is wrapped: `{ success, statusCode, message, data: { secret } }`.
}
