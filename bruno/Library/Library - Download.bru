meta {
  name: Library - Download
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/library/:artifact/download
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  artifact: {{libraryArtifactId}}
}

docs {
  Downloads a library file as an attachment. Requires `agent.view`. 404
  unless the file belongs to this workspace, came from a chat or the
  workflow builder, and is accessible to the caller.

  The response is the raw file (`Content-Disposition: attachment`), not
  the JSON envelope.
}
