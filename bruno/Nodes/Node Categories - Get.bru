meta {
  name: Node Categories - Get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/node-categories/:nodeCategory
  body: none
  auth: inherit
}

params:path {
  nodeCategory: {{nodeCategoryId}}
}

docs {
  Fetches a single category plus the built-in (registry) nodes filed
  under it. Custom nodes aren't included here — use
  `Nodes - List` with `?category=...` for those.

  Response is wrapped:
  `{ success, statusCode, message, data: { category, nodes, nodes_count } }`.
}
