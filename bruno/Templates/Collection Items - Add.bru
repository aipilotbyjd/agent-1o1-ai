meta {
  name: Collection Items - Add
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/template-collections/:templateCollection/items
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  templateCollection: {{templateCollectionId}}
}

body:json {
  {
    "templatable_type": "workflow_template",
    "templatable_id": {{workflowTemplateId}},
    "position": 0
  }
}

script:post-response {
  if (res.status === 201) {
    const item = res.body.data?.item;
    if (item && item.id) {
      bru.setVar("templateCollectionItemId", item.id);
    }
  }
}

docs {
  Adds a workflow template or an agent template to the collection.
  Requires the `template.manage` permission. Stores the new item's ID in
  the `templateCollectionItemId` collection variable.

  - `templatable_type` — required, either `workflow_template` or
    `agent_template`.
  - `templatable_id` — required integer, the template's ID. Swap it to
    `{{agentTemplateId}}` when adding an agent template.
  - `position` — optional integer from 0, the ordering slot.

  Response is wrapped: `{ success, statusCode, message, data: { item } }`
  with the underlying template loaded.
}
