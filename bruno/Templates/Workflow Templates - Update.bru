meta {
  name: Workflow Templates - Update
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/workspaces/:workspace/workflow-templates/:workflowTemplate
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  workflowTemplate: {{workflowTemplateId}}
}

body:json {
  {
    "name": "Lead intake starter v2",
    "category": "sales",
    "visibility": "public"
  }
}

docs {
  Updates a workflow template's metadata. Requires the `template.manage`
  permission. Every field is `sometimes` — send only what changes.

  Unlike `Get`, this one requires the template to be *owned* by the
  workspace, not merely visible to it: a global public template answers
  `404` here.

  `graph` and `slug` are not updatable through this endpoint — create a new
  template to change the graph.

  Response is wrapped:
  `{ success, statusCode, message, data: { workflow_template } }`.
}
