meta {
  name: Template Collections - Delete
  type: http
  seq: 19
}

delete {
  url: {{baseUrl}}/v1/workspaces/:workspace/template-collections/:templateCollection
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  templateCollection: {{templateCollectionId}}
}

docs {
  Deletes a collection owned by the workspace. Requires the
  `template.manage` permission. A global public collection answers `404`.

  Only the grouping is removed — the workflow and agent templates it
  pointed at survive.

  Answers `204 No Content` with no envelope.
}
