meta {
  name: Public Page - Record Event
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/v1/p/:token/events
  body: json
  auth: none
}

params:path {
  token: {{pageToken}}
}

headers {
  ~X-Page-Visitor: bruno-visitor-0001
}

body:json {
  {
    "type": "start"
  }
}

docs {
  Records that an anonymous visitor started filling in the page, for
  `Insights - Get`. No auth. Throttled to 120/min per IP.

  - `type` — required, must be `start`. Counted once per visitor per day.
  - `X-Page-Visitor` — optional, same as `Public Page - Get`.

  Answers `204 No Content` with no envelope.
}
