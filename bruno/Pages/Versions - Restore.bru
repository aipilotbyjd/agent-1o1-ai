meta {
  name: Versions - Restore
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/pages/:page/versions/:version/restore
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  page: {{pageId}}
  version: {{pageVersionId}}
}

docs {
  Copies a version back into the draft. Requires the `page.manage`
  permission. The current draft is snapshotted first as a
  `before_restore` version. Version B is restored only when both the
  version and the page have one.

  The live page is untouched — publish to make the restore live.

  Response is wrapped: `{ success, statusCode, message, data: { page } }`.
}
