meta {
  name: Artifacts - Download
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/artifacts/:artifact/download
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  artifact: {{artifactId}}
}

docs {
  Streams the artifact's bytes as an attachment. Requires `artifact.view`.
}
