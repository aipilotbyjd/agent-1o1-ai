meta {
  name: Plans - Archive
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/super-admin/v1/pricing/plans/:plan/archive
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  plan: {{saPlanId}}
}

body:json {
  {
    "reason": "Verified request from the account owner",
    "totp_code": "123456"
  }
}

docs {
  Hides and deactivates a plan. The default plan can't be archived.
}
