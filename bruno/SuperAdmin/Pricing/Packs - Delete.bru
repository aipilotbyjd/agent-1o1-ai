meta {
  name: Packs - Delete
  type: http
  seq: 22
}

delete {
  url: {{baseUrl}}/super-admin/v1/pricing/packs/:pack
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  pack: {{saPackId}}
}

body:json {
  {
    "reason": "Verified request from the account owner",
    "totp_code": "123456"
  }
}

docs {
  Only a pack nobody has bought; otherwise deactivate it.
}
