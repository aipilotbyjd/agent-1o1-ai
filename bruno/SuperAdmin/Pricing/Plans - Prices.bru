meta {
  name: Plans - Prices
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/super-admin/v1/pricing/plans/:plan/prices
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  plan: {{saPlanId}}
}

body:json {
  {
    "reason": "Verified request from the account owner",
    "totp_code": "123456",
    "prices": { "monthly": 3900 }
  }
}

docs {
  New amounts, in cents, for new purchases only. Creates new Stripe prices and archives the old ones; subscribers on the old price are unaffected.
}
