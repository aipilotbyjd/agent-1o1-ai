meta {
  name: Plans - Duplicate
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/super-admin/v1/pricing/plans/:plan/duplicate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  plan: {{saPlanId}}
}

body:json {
  {
    "name": "Pro Plus",
    "slug": "pro-plus"
  }
}

docs {
  Copies a plan into an inactive draft with no Stripe ids.
}
