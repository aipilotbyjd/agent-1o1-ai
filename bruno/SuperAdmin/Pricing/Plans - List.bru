meta {
  name: Plans - List
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/super-admin/v1/pricing/plans
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const v = res.body.data?.[0]?.id;
    if (v) bru.setVar("saPlanId", v);
  }
}

docs {
  Plans in display order with subscriber counts. `?archived=1` includes archived plans. Stores the first as `saPlanId`.
}
