meta {
  name: Plans - Stripe Sync
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/super-admin/v1/pricing/plans/:plan/stripe/sync
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  plan: {{saPlanId}}
}

body:json {
  {
    "dry_run": true
  }
}

docs {
  Creates a missing Stripe product or prices from the plan's amounts. `dry_run: true` only reports and needs no code; a real sync needs `reason` and `totp_code`.
}
