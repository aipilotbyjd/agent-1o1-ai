meta {
  name: Coupons - Deactivate
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/super-admin/v1/pricing/coupons/:coupon/deactivate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  coupon: {{saCouponId}}
}

body:json {
  {
    "reason": "Verified request from the account owner",
    "totp_code": "123456"
  }
}

docs {
  Switches the promotion code off.
}
