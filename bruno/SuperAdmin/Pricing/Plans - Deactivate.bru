meta {
  name: Plans - Deactivate
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/super-admin/v1/pricing/plans/:plan/deactivate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  plan: {{saPlanId}}
}

body:json {
  {
    "reason": "Verified request from the account owner",
    "totp_code": "123456"
  }
}

docs {
  Withdraws the plan from sale. Existing subscribers keep it. The default plan can't be deactivated.
}
