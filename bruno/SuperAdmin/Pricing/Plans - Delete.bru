meta {
  name: Plans - Delete
  type: http
  seq: 15
}

delete {
  url: {{baseUrl}}/super-admin/v1/pricing/plans/:plan
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  plan: {{saPlanId}}
}

body:json {
  {
    "reason": "Verified request from the account owner",
    "totp_code": "123456"
  }
}

docs {
  Only for a plan with no subscriptions, grants, usage or referral rules. Otherwise archive it.
}
