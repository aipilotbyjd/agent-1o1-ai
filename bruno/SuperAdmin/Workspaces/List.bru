meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/super-admin/v1/workspaces?q=&status=
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:query {
  q: 
  status: 
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const v = res.body.data?.[0]?.id;
    if (v) bru.setVar("saWorkspaceId", v);
  }
}

docs {
  Filters: `q` (name or slug), `status` (active, suspended). Stores the first row as `saWorkspaceId`.
}
