meta {
  name: Members
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/super-admin/v1/workspaces/:workspace/members
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  workspace: {{saWorkspaceId}}
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const v = res.body.data?.[1]?.id ?? res.body.data?.[0]?.id;
    if (v) bru.setVar("saMemberId", v);
  }
}

docs {
  Stores a member id as `saMemberId`.
}
