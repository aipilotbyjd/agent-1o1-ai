meta {
  name: Get
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/super-admin/v1/models/:model
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  model: {{saModelId}}
}

docs {
  One model with its routes and how many agents, assistants and workspace settings use it.
}
