meta {
  name: Routes - Remove
  type: http
  seq: 14
}

delete {
  url: {{baseUrl}}/super-admin/v1/models/:model/routes/:route
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  model: {{saModelId}}
  route: {{saRouteId}}
}

body:json {
  {
    "reason": "Routing around a provider outage"
  }
}

docs {
  Removes a route. The only enabled route of an active model cannot be removed.
}
