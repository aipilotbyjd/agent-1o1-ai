meta {
  name: Prices - List
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/super-admin/v1/models/prices?provider=&q=&stale=
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:query {
  provider: 
  q: 
  stale: 
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const v = res.body.data?.[0]?.id;
    if (v) bru.setVar("saPriceId", v);
  }
}

docs {
  What each backend model costs per million tokens. `stale=1` lists prices never confirmed or older than 90 days.
}
