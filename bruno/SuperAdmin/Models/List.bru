meta {
  name: List
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/super-admin/v1/models?q=&status=&internal=
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:query {
  q: 
  status: 
  internal: 
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const v = res.body.data?.[0]?.id;
    if (v) bru.setVar("saModelId", v);
  }
  const r = res.body.data?.[0]?.routes?.[0]?.id;
  if (r) bru.setVar("saRouteId", r);
}

docs {
  The whole catalog with its routes. Filters: `q`, `status` (draft, active, deprecated, overdue, retired), `internal=1|0`. Stores the first model and its first route.
}
