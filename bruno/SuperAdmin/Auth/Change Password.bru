meta {
  name: Change Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/super-admin/v1/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

body:json {
  {
    "current_password": "change-me-please",
    "password": "A-new-passw0rd!-of-14+",
    "password_confirmation": "A-new-passw0rd!-of-14+"
  }
}

docs {
  14+ characters with mixed case, a number and a symbol. Signs out every other session. A temporary or expired password can do nothing else until this is done.
}
