meta {
  name: Templates - List
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/super-admin/v1/catalog/templates/:type?platform=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:query {
  platform: 1
}

params:path {
  type: workflow
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const v = res.body.data?.[0]?.id;
    if (v) bru.setVar("saTemplateId", v);
  }
}

docs {
  `type`: workflow, agent or page. `platform=1` lists only platform templates. Stores the first as `saTemplateId`.
}
