meta {
  name: Nodes - List
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/super-admin/v1/catalog/nodes?active=
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:query {
  active: 
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const v = res.body.data?.[0]?.id;
    if (v) bru.setVar("saNodeId", v);
  }
}

docs {
  Custom nodes across workspaces. Stores the first as `saNodeId`.
}
