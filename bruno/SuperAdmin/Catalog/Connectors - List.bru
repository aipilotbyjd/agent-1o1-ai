meta {
  name: Connectors - List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/super-admin/v1/catalog/connectors?q=
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:query {
  q: 
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const v = res.body.data?.[0]?.id;
    if (v) bru.setVar("saConnectorId", v);
  }
}

docs {
  Stores the first as `saConnectorId`.
}
