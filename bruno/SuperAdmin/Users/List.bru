meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/super-admin/v1/users?q=&status=&sort=-created_at
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:query {
  q: 
  status: 
  sort: -created_at
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const v = res.body.data?.[0]?.id;
    if (v) bru.setVar("saUserId", v);
  }
}

docs {
  Filters: `q` (name or email), `status` (active, suspended, unverified), `sort` (created_at, name, email; prefix `-` to reverse). Stores the first row as `saUserId`.
}
