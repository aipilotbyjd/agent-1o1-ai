meta {
  name: Get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/super-admin/v1/billing/workspaces/:workspace
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  workspace: {{saWorkspaceId}}
}

docs {
  Plan, subscription, top-up credits and the current usage period. Read-only.
}
