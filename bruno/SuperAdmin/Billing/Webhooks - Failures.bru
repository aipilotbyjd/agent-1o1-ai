meta {
  name: Webhooks - Failures
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/super-admin/v1/billing/webhooks/failures?status=open
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

script:post-response {
  if (res.status === 200) {
    const first = res.body.data?.[0];
    if (first) bru.setVar("saStripeEventId", first.event_id);
  }
}

docs {
  Stripe events our handler failed on, open ones first. Filter with `status` (open, resolved) and `limit`.
  A failed delivery leaves no other trace, so if Stripe stopped retrying, this is where a paid
  checkout that never fulfilled shows up. Stores the first as `saStripeEventId`.
}
