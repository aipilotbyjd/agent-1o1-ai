meta {
  name: Retry
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/super-admin/v1/runs/:run/retry
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  run: {{saRunId}}
}

body:json {
  {
    "reason": "Verified request, ticket 1234"
  }
}

docs {
  Starts a new run from a finished one.
}
