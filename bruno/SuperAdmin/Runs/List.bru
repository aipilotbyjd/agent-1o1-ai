meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/super-admin/v1/runs?status=failed&workspace_id=&with_error=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:query {
  status: failed
  workspace_id: 
  with_error: 1
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const v = res.body.data?.[0]?.id;
    if (v) bru.setVar("saRunId", v);
  }
}

docs {
  Cursor-paginated. Filters: `status`, `workspace_id`, `from`, `to`, `with_error=1`. Stores the first as `saRunId`.
}
