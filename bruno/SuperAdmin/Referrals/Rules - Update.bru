meta {
  name: Rules - Update
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/super-admin/v1/referrals/rules/:rule
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  rule: {{referralRuleId}}
}

body:json {
  {
    "credits_amount": 5000
  }
}

docs {
  Partial update, checked against the rule as it would be saved. Rewards
  already earned keep the terms they were earned under.

  Response is wrapped: `{ success, statusCode, message, data: { rule } }`.
}
