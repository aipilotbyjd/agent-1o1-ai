meta {
  name: Programs - Get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/super-admin/v1/referrals/programs/:program
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  program: {{referralProgramId}}
}

docs {
  One program with every setting, its resolved fraud checks and its rules.

  Response is wrapped: `{ success, statusCode, message, data: { program } }`.
}
