meta {
  name: Programs - Make Default
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/super-admin/v1/referrals/programs/:program/make-default
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  program: {{referralProgramId}}
}

docs {
  Makes an active program the default; the previous default is demoted.
  New signups whose code doesn't point at a program join the default.

  Response is wrapped: `{ success, statusCode, message, data: { program } }`.
}
