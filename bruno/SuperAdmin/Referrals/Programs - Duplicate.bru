meta {
  name: Programs - Duplicate
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/super-admin/v1/referrals/programs/:program/duplicate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  program: {{referralProgramId}}
}

docs {
  Copies the program and its rules as "<name> (copy)", switched off and not
  default — the quick way to build a campaign from the default program.

  `201`, wrapped: `{ success, statusCode, message, data: { program } }`.
}
