meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/super-admin/v1/accounts?q=&role=
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:query {
  q: 
  role: 
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const v = res.body.data?.[0]?.id;
    if (v) bru.setVar("saAccountId", v);
  }
}

docs {
  Filters: `q`, `role`, `disabled=1`. Stores the first row as `saAccountId`.
}
