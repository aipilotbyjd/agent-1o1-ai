meta {
  name: Disable
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/super-admin/v1/accounts/:account/disable
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  account: {{saAccountId}}
}

body:json {
  {
    "reason": "Verified request from the account owner",
    "totp_code": "123456"
  }
}

docs {
  Disables the account and revokes every token.
}
