meta {
  name: Revoke Sessions
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/super-admin/v1/accounts/:account/revoke-sessions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  account: {{saAccountId}}
}

body:json {
  {
    "reason": "Verified request from the account owner",
    "totp_code": "123456"
  }
}

docs {
  Signs the account out everywhere.
}
