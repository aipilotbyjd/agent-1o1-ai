meta {
  name: Enable
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/super-admin/v1/accounts/:account/enable
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  account: {{saAccountId}}
}

body:json {
  {
    "reason": "Verified request from the account owner",
    "totp_code": "123456"
  }
}

docs {
  Re-enables a disabled account and clears any lock.
}
