meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/super-admin/v1/audit-log?action=&actor=&subject_type=&per_page=50
  body: none
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:query {
  action: 
  actor: 
  subject_type: 
  per_page: 50
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const v = res.body.data?.[0]?.id;
    if (v) bru.setVar("saLogId", v);
  }
}

docs {
  Newest first, cursor-paginated: pass `meta.next_cursor` back as `cursor`. Filters: `action` (prefix, e.g. `billing.`), `actor` (super admin id), `subject_type`, `subject_id`, `from`, `to`.
}
