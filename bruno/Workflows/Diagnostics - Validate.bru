meta {
  name: Diagnostics - Validate
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/workflows/:workflow/validate
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  workflow: {{workflowId}}
}

body:json {
  {
    "graph": {
      "nodes": [
        { "key": "trigger", "type": "manual_trigger", "config": {} },
        { "key": "notify", "type": "http_request", "config": {} }
      ],
      "edges": [
        { "from": "trigger", "to": "notify", "condition": null }
      ]
    }
  }
}

docs {
  Checks a graph for structural problems before publishing. Requires the
  `workflow.manage` permission.

  - `graph` — optional. Supply it to check the unsaved canvas; omit it (or
    send `null`) to check the saved draft, through the same accessor
    publishing uses, so what's validated is what would be published.
  - Each node needs `key` and `type`, `config` optional. Each edge needs
    `from` and `to` (node keys), `condition` optional.

  Answers `200` with the findings even when the graph is invalid — an
  invalid graph is the *expected* result of asking "is this valid yet?",
  not a rejected request. Publishing is where invalidity becomes an error.

  Response is wrapped:
  `{ success, statusCode, message, data: { valid, issues } }`.
}
