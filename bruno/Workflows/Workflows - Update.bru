meta {
  name: Workflows - Update
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/workspaces/:workspace/workflows/:workflow
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  workflow: {{workflowId}}
}

body:json {
  {
    "name": "Lead intake (v2)",
    "description": "Routes inbound leads to the sales queue."
  }
}

docs {
  Updates a workflow's metadata — `name`, `slug`, `description`, or
  `folder_id`. All fields are optional; the graph itself is edited
  through the `Workflow Builder` folder, not here. Requires the
  `workflow.manage` permission.

  Response is wrapped: `{ success, statusCode, message, data: { workflow } }`.
}
