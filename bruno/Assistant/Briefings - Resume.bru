meta {
  name: Briefings - Resume
  type: http
  seq: 53
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/assistant/briefings/:type/resume
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  type: daily
}

docs {
  Clears a pause set by `Briefings - Pause`. Requires the `assistant.use`
  permission. `type` is `daily` or `meeting_prep`.

  Response is wrapped: same shape as `Briefings - Get`, with
  `config.paused: false`.
}
