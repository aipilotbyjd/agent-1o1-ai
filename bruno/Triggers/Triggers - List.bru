meta {
  name: Triggers - List
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/triggers
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's triggers, newest first. Requires the
  `trigger.view` permission.

  Response is wrapped: `{ success, statusCode, message, data: { triggers } }`.
}
