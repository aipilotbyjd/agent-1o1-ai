meta {
  name: Onboarding - Complete
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/onboarding/complete
  body: none
  auth: inherit
}

docs {
  Marks onboarding as completed (`onboarding_completed_at`).

  Response is wrapped: `{ success, statusCode, message, data }` where `data`
  is the full onboarding state (same shape as `Onboarding - Get State`).
}
