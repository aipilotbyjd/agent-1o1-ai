meta {
  name: Onboarding - Get State
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/user/onboarding
  body: none
  auth: inherit
}

docs {
  Returns the authenticated user's onboarding progress: `dismissed`,
  `completed`, `percent`, `current_step`, `steps[]`, and `meta` (plan
  catalog, job roles, discovery sources, workspace slug suggestion).
}
