meta {
  name: Provider Credentials - Set Default
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/ai-provider-credentials/:aiProviderCredential/default
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  aiProviderCredential: {{aiProviderCredentialId}}
}

docs {
  Makes this the key used for its provider within its group (team, or
  the caller's personal keys), replacing the previous default. Same
  permission rules as `Provider Credentials - Update`. Recorded in the
  workspace audit log.

  Response is wrapped:
  `{ success, statusCode, message, data: { ai_provider_credential } }`.
}
