meta {
  name: Provider Credentials - Update
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/v1/workspaces/:workspace/ai-provider-credentials/:aiProviderCredential
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  aiProviderCredential: {{aiProviderCredentialId}}
}

body:json {
  {
    "name": "Team OpenAI key (rotated)",
    "api_key": "sk-placeholder-rotated"
  }
}

docs {
  Renames a key and/or replaces it. Both fields are optional. Needs
  `ai-credential.manage` for a team key, `ai-credential.use-personal` for
  the caller's own personal key; someone else's personal key is a 404.
  Throttled by `ai-credential-checks`.

  A new `api_key` (8-500 chars) is checked with the provider exactly as
  on create — rejected is a 422, unreachable stores it `unvalidated`.
  Provider and scope can't be changed.

  Response is wrapped:
  `{ success, statusCode, message, data: { ai_provider_credential } }`.
}
