meta {
  name: Provider Credentials - Validate
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/ai-provider-credentials/:aiProviderCredential/validate
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  aiProviderCredential: {{aiProviderCredentialId}}
}

docs {
  Checks the stored key with the provider now and updates its
  `validation_status`. Same permission rules as
  `Provider Credentials - Update`. Throttled by `ai-credential-checks`.

  A failed check is a result, not an error: the response is 200 either
  way, with `result.ok` saying which and `result.message` why.

  Response is wrapped:
  `{ success, statusCode, message, data: { result: { ok, message }, ai_provider_credential } }`.
}
