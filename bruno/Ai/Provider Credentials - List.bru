meta {
  name: Provider Credentials - List
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/ai-provider-credentials
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's own AI provider keys, ordered by provider then
  age. Requires `ai-credential.view`.

  Only keys visible to the caller come back: every `team` key plus the
  caller's own `personal` ones. The key itself is never returned — only
  `key_hint`, `validation_status`, `is_default`, `ignored_by_policy` (a
  personal key kept while personal keys are turned off) and `can_manage`.

  Response is wrapped:
  `{ success, statusCode, message, data: { ai_provider_credentials } }`.
}
