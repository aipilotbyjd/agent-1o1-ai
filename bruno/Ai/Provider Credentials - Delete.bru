meta {
  name: Provider Credentials - Delete
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/v1/workspaces/:workspace/ai-provider-credentials/:aiProviderCredential
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  aiProviderCredential: {{aiProviderCredentialId}}
}

docs {
  Removes a key (soft delete — `Provider Credentials - Restore` undoes
  it). Same permission rules as `Provider Credentials - Update`.

  Removing the group's default hands that role to the group's oldest
  remaining key.

  Responds `204 No Content` with no envelope.
}
