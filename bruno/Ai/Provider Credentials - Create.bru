meta {
  name: Provider Credentials - Create
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/ai-provider-credentials
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

body:json {
  {
    "execution_provider": "openai",
    "api_key": "sk-placeholder",
    "name": "Team OpenAI key",
    "scope": "team",
    "is_default": true
  }
}

script:post-response {
  if (res.status === 201) {
    const credential = res.body.data?.ai_provider_credential;
    if (credential && credential.id) {
      bru.setVar("aiProviderCredentialId", credential.id);
    }
  }
}

docs {
  Stores a workspace's own key for an AI provider. A `team` key needs
  `ai-credential.manage`; a `personal` one needs
  `ai-credential.use-personal` and the policy's `allow_personal_keys`
  (422 otherwise). Throttled by `ai-credential-checks`.

  - `execution_provider` — required; a `key` from `Providers - List`
    (`openai`, `anthropic`, `gemini`, `mistral`, `deepseek`, `xai`,
    `groq`, `openrouter`, `fireworks`, `together`).
  - `api_key` — required, 8-500 chars. Checked with the provider first:
    a rejected key is a 422 on `api_key`; an unreachable provider stores
    it as `unvalidated` and re-checks in the background.
  - `name` — optional. `scope` — `team` (default) or `personal`.
  - `is_default` — optional; the first key in its group becomes the
    default regardless.

  Stores the new id as `aiProviderCredentialId`. The message is the
  provider check's result.

  Response is wrapped (201):
  `{ success, statusCode, message, data: { ai_provider_credential } }`.
}
