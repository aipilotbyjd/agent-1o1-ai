meta {
  name: Provider Credentials - Restore
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/ai-provider-credentials/:aiProviderCredential/restore
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  aiProviderCredential: {{aiProviderCredentialId}}
}

docs {
  Brings back a removed key (the screen's "Undo"). Same permission rules
  as `Provider Credentials - Update`; 404 if the key isn't deleted.

  It returns as its group's default only if the group has none by now.

  Response is wrapped:
  `{ success, statusCode, message, data: { ai_provider_credential } }`.
}
