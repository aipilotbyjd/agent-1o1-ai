meta {
  name: Runs - List
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/runs
  body: none
  auth: inherit
}

params:query {
  ~status: completed
  ~workflow_id: {{workflowId}}
  ~per_page: 25
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's runs (workflow runs plus agent chat turns,
  reflections, evaluations and eval runs), newest first. Requires the
  `run.view` permission.

  Optional filters: `status` (`pending`, `running`, `awaiting_approval`,
  `awaiting_callback`, `completed`, `failed`, `cancelled`), `workflow_id`,
  `agent_id`, `runnable_type` (`workflow`, `agent_session`,
  `reflection_run`, `agent_session_evaluation`, `agent_eval_run`),
  `trigger_type`, `exclude_trigger_type`, and `per_page` (1-100,
  default 25).

  Response is paginated: `{ success, statusCode, message, data, meta, links }`.
}
