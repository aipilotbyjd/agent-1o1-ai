meta {
  name: Skills - List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/skills
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's skills, newest first. Requires the `agent.view`
  permission.

  Response is wrapped: `{ success, statusCode, message, data: { skills } }`.
}
