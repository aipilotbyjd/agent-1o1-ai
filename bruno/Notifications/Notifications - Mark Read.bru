meta {
  name: Notifications - Mark Read
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/notifications/:notification/read
  body: none
  auth: inherit
}

params:path {
  notification: {{notificationId}}
}

docs {
  Marks one of the caller's notifications read. Someone else's id answers
  `404`. Uses `notificationId` from `Notifications - List`.

  Response is wrapped: `{ success, statusCode, message, data }` where `data`
  is the notification itself (same shape as a list item).
}
