meta {
  name: Notification Channels - Update
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/v1/workspaces/:workspace/notification-channels/:notificationChannel
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  notificationChannel: {{notificationChannelId}}
}

body:json {
  {
    "is_active": false
  }
}

docs {
  Partial update. Requires `notification-channel.manage`. `type` can't be
  changed. Sending `config` replaces it whole, so `config.url` is then
  required again; other fields as in `Create`.

  Response is wrapped: `{ success, statusCode, message, data: { channel } }`.
}
