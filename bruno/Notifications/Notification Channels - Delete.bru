meta {
  name: Notification Channels - Delete
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/v1/workspaces/:workspace/notification-channels/:notificationChannel
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  notificationChannel: {{notificationChannelId}}
}

docs {
  Deletes the channel. Requires `notification-channel.manage`.

  Answers `200` with `data: null` (not 204).
}
