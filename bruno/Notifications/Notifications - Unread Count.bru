meta {
  name: Notifications - Unread Count
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/notifications/unread-count
  body: none
  auth: inherit
}

docs {
  How many of the caller's notifications are unread — for a bell badge.

  Response is wrapped: `{ success, statusCode, message, data: { unread } }`.
}
