meta {
  name: Notifications - Delete
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/v1/notifications/:notification
  body: none
  auth: inherit
}

params:path {
  notification: {{notificationId}}
}

docs {
  Deletes one of the caller's notifications. Someone else's id answers
  `404`. Uses `notificationId` from `Notifications - List`.

  Answers `200` with `data: null` (not 204).
}
