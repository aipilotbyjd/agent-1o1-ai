meta {
  name: Graph - Replace
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/v1/workspaces/:workspace/workflows/:workflow/graph
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
  workflow: {{workflowId}}
}

body:json {
  {
    "nodes": [
      {
        "key": "trigger",
        "type": "manual.trigger",
        "config": {},
        "position": { "x": 0, "y": 0 }
      },
      {
        "key": "notify",
        "type": "http.request",
        "config": {
          "method": "POST",
          "url": "https://example.com/hooks/notify"
        },
        "position": { "x": 240, "y": 0 }
      }
    ],
    "edges": [
      {
        "from": "trigger",
        "to": "notify",
        "condition": null
      }
    ]
  }
}

docs {
  Replaces the workflow's draft graph wholesale — this is the editor's
  autosave, not a partial patch, so send the complete node/edge set every
  time. Requires the `workflow-builder.use` permission.

  Both `nodes` and `edges` must be present (send `[]` to clear one).
  Each node needs a `key` and `type`; edges reference nodes by `key` via
  `from`/`to`. Node `type` must be registered in the node registry.

  Publish the result through `Workflows/Versions - Publish`.

  Response is wrapped: `{ success, statusCode, message, data: { workflow } }`.
}
