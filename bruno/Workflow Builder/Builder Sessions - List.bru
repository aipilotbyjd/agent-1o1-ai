meta {
  name: Builder Sessions - List
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/workflow-builder-sessions
  body: none
  auth: inherit
}

params:query {
  ~status: active
  ~mine: 1
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's chat-based builder sessions, newest first.
  Requires the `workflow-builder.use` permission.

  Archived sessions are listed only with `status=archived`; `mine=1`
  narrows the list to sessions the caller created. Items leave out
  `draft_graph` — fetch a session to get its graph.

  Response is wrapped: `{ success, statusCode, message, data: { sessions } }`.
}
