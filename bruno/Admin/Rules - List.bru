meta {
  name: Rules - List
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/v1/admin/referrals/programs/:program/rules
  body: none
  auth: inherit
}

params:path {
  program: {{referralProgramId}}
}

script:post-response {
  if (res.status === 200) {
    const items = res.body.data?.rules;
    if (Array.isArray(items) && items.length > 0) {
      bru.setVar("referralRuleId", items[0].id);
    }
  }
}

docs {
  The program's reward rules in order, each with a plain-English `summary`.

  Stores the first rule as `referralRuleId`.
}
