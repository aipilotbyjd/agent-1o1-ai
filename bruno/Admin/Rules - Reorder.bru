meta {
  name: Rules - Reorder
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/v1/admin/referrals/programs/:program/rules/reorder
  body: json
  auth: inherit
}

params:path {
  program: {{referralProgramId}}
}

body:json {
  {
    "rule_ids": [
      "{{referralRuleId}}"
    ]
  }
}

docs {
  Sets the order of the program's rules. `rule_ids` must all belong to the
  program; the list order becomes `sort_order`.
}
