meta {
  name: Programs - Simulate
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/admin/referrals/programs/:program/simulate
  body: json
  auth: inherit
}

params:path {
  program: {{referralProgramId}}
}

body:json {
  {
    "trigger": "first_payment",
    "payment_cents": 9900,
    "billing_interval": "monthly",
    "payment_source": "subscription",
    "payment_sequence": 1,
    "multiplier": 1
  }
}

docs {
  Dry run: what each rule would give for a hypothetical event. Writes
  nothing. `trigger` is required (`signup_verified`, `activated`,
  `first_payment`, `repeat_payment`, `milestone`); payment fields apply to
  payment triggers, `converted_referrals` to milestones, `multiplier`
  mimics a referral code's multiplier.
}
