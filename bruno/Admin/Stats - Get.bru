meta {
  name: Stats - Get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/admin/referrals/stats?days=30
  body: none
  auth: inherit
}

params:query {
  days: 30
}

docs {
  Platform-wide numbers for the last `days` (1–3650, default 30): visits,
  signups, activation and conversion rates, credits/days/invoice credit
  issued, clawbacks, rewards awaiting approval or on hold, top referrers.

  Response is wrapped: `{ success, statusCode, message, data }`.
}
