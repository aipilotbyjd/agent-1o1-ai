# Task scheduler (schedule:work, no cron)
FROM serversideup/php:8.4-fpm-nginx

USER root
RUN install-php-extensions pcntl intl bcmath exif pdo_pgsql

ENV PHP_OPCACHE_ENABLE=1 SSL_MODE=off

USER www-data
WORKDIR /var/www/html

COPY --chown=www-data:www-data composer.json composer.lock ./
RUN composer install --no-dev --no-interaction \
    --prefer-dist --no-scripts --no-autoloader

COPY --chown=www-data:www-data . .
RUN composer dump-autoload --optimize --no-dev

STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["healthcheck-schedule"]

# Add ->onOneServer() to every scheduled task so overlapping
# schedulers during a deploy never double-fire.
CMD ["php", "/var/www/html/artisan", "schedule:work"]
