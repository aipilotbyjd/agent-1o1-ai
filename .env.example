APP_NAME="Agent1o1 API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
VERBOO_API_KEY=
XKIRO_API_KEY=

PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/internal/auth/social/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/api/internal/auth/social/github/callback"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US

# Estate-wide kill switch per billing window — withdraws an interval from
# sale across every plan. Existing subscriptions and lifetime grants on a
# disabled interval keep working; only new purchases are blocked.
BILLING_INTERVAL_MONTHLY_ENABLED=true
BILLING_INTERVAL_QUARTERLY_ENABLED=true
BILLING_INTERVAL_YEARLY_ENABLED=true
BILLING_INTERVAL_LIFETIME_ENABLED=true

STRIPE_PLAN_STARTER_PRODUCT_ID=
STRIPE_PLAN_STARTER_MONTHLY_PRICE_ID=
STRIPE_PLAN_STARTER_QUARTERLY_PRICE_ID=
STRIPE_PLAN_STARTER_YEARLY_PRICE_ID=
# One-time (not recurring) Stripe price — a lifetime purchase is a
# mode=payment Checkout Session, not a subscription.
STRIPE_PLAN_STARTER_LIFETIME_PRICE_ID=
STRIPE_PLAN_PRO_PRODUCT_ID=
STRIPE_PLAN_PRO_MONTHLY_PRICE_ID=
STRIPE_PLAN_PRO_QUARTERLY_PRICE_ID=
STRIPE_PLAN_PRO_YEARLY_PRICE_ID=
STRIPE_PLAN_PRO_LIFETIME_PRICE_ID=

ADMIN_ALERTS_ENABLED=true
ADMIN_ALERT_EMAILS=
ADMIN_ALERT_DISCORD_WEBHOOK=
ADMIN_ALERT_WEBHOOK_URL=
ADMIN_ALERT_WEBHOOK_SECRET=
ADMIN_ALERT_THROTTLE_SECONDS=3600
ADMIN_ALERT_USAGE_THRESHOLD_PERCENT=80

# Referral program: everything else is configured from the admin API.
REFERRALS_ENABLED=true
PLATFORM_ADMIN_REQUIRE_2FA=true
# Set false to turn the /v1/admin API off and manage everything from artisan.
PLATFORM_ADMIN_API_ENABLED=true

GOOGLE_CONNECTORS_CLIENT_ID=
GOOGLE_CONNECTORS_CLIENT_SECRET=

MICROSOFT_CONNECTORS_CLIENT_ID=
MICROSOFT_CONNECTORS_CLIENT_SECRET=

# Personal assistant brand — the only place its name is set.
# See docs/ASSISTANT_BRANDING_PLAN.md. After changing: `php artisan config:cache && php artisan assistant:brand-refresh`.
ASSISTANT_NAME=Orb
ASSISTANT_TAGLINE="Your personal AI agent"
ASSISTANT_DESCRIPTION="Reads your apps, preps your day and handles your inbox."
ASSISTANT_EMOJI=🔮
ASSISTANT_COLOR=#7C3AED
ASSISTANT_ICON_URL=/brand/assistant/icon.svg
ASSISTANT_AVATAR_URL=/brand/assistant/icon.svg
ASSISTANT_FEATURE_DAILY=":name Daily"
ASSISTANT_FEATURE_INBOX=":name Inbox"
ASSISTANT_FEATURE_PREP=":name Prep"
ASSISTANT_FEATURE_SITUATIONS=Situations
ASSISTANT_EMAIL=orb
ASSISTANT_EMAIL_ALIASES=
ASSISTANT_INBOUND_DOMAIN=agent1o1.ai
ASSISTANT_SMS_SIGNATURE="— :name"

# Personal assistant channels (docs/ASSISTANT_PLAN.md §7).
ASSISTANT_EMAIL_INBOUND_TOKEN=
ASSISTANT_EMAIL_REQUIRE_AUTH=true
ASSISTANT_SLACK_CLIENT_ID=
ASSISTANT_SLACK_CLIENT_SECRET=
ASSISTANT_SLACK_SIGNING_SECRET=

E2B_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ASSISTANT_SMS_FROM=
