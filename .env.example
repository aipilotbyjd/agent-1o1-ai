# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Agent1o1 API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# =============================================================================
# LOGGING
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE
# =============================================================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# =============================================================================
# SESSION, CACHE, QUEUE & STORAGE
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Memcached ---------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1

# --- Redis -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# MAIL
# =============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# AWS
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# VITE
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# =============================================================================
# REVERB (WEBSOCKETS)
# =============================================================================
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Hosts allowed to open websocket connections (comma-separated). Defaults to the APP_FRONTEND_URL host.
# REVERB_ALLOWED_ORIGINS=
# Set to true when more than one Reverb server runs: they then share events through Redis.
# REVERB_SCALING_ENABLED=false

# =============================================================================
# AI PROVIDERS
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
VERBOO_API_KEY=
XKIRO_API_KEY=

# --- Embeddings --------------------------------------------------------------
# What knowledge sources embed with (openai, gemini, ollama…). Re-sync
# every source after changing it.
AI_EMBEDDINGS_PROVIDER=openai
GEMINI_EMBEDDINGS_DIMENSIONS=768

# --- Sandbox -----------------------------------------------------------------
E2B_API_KEY=

# =============================================================================
# AUTHENTICATION
# =============================================================================
# --- Passport ----------------------------------------------------------------
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=

# --- Social login: Google ----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/internal/auth/social/google/callback"

# --- Social login: GitHub ----------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/api/internal/auth/social/github/callback"

# =============================================================================
# BILLING (STRIPE & CASHIER)
# =============================================================================
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US

# --- Billing intervals -------------------------------------------------------
# Estate-wide kill switch per billing window — withdraws an interval from
# sale across every plan. Existing subscriptions and lifetime grants on a
# disabled interval keep working; only new purchases are blocked.
BILLING_INTERVAL_MONTHLY_ENABLED=true
BILLING_INTERVAL_QUARTERLY_ENABLED=true
BILLING_INTERVAL_YEARLY_ENABLED=true
BILLING_INTERVAL_LIFETIME_ENABLED=true

# --- Plan: Starter -----------------------------------------------------------
STRIPE_PLAN_STARTER_PRODUCT_ID=
STRIPE_PLAN_STARTER_MONTHLY_PRICE_ID=
STRIPE_PLAN_STARTER_QUARTERLY_PRICE_ID=
STRIPE_PLAN_STARTER_YEARLY_PRICE_ID=
# One-time (not recurring) Stripe price — a lifetime purchase is a
# mode=payment Checkout Session, not a subscription.
STRIPE_PLAN_STARTER_LIFETIME_PRICE_ID=

# --- Plan: Pro ---------------------------------------------------------------
STRIPE_PLAN_PRO_PRODUCT_ID=
STRIPE_PLAN_PRO_MONTHLY_PRICE_ID=
STRIPE_PLAN_PRO_QUARTERLY_PRICE_ID=
STRIPE_PLAN_PRO_YEARLY_PRICE_ID=
STRIPE_PLAN_PRO_LIFETIME_PRICE_ID=

# --- Referrals ---------------------------------------------------------------
# Referral program: everything else is configured from the admin API.
REFERRALS_ENABLED=true

# =============================================================================
# ADMIN ALERTS
# =============================================================================
ADMIN_ALERTS_ENABLED=true
ADMIN_ALERT_EMAILS=
ADMIN_ALERT_DISCORD_WEBHOOK=
ADMIN_ALERT_WEBHOOK_URL=
ADMIN_ALERT_WEBHOOK_SECRET=
ADMIN_ALERT_THROTTLE_SECONDS=3600
ADMIN_ALERT_USAGE_THRESHOLD_PERCENT=80

# =============================================================================
# SUPER ADMIN PANEL
# =============================================================================
# See docs/SUPER_ADMIN_PLAN.md. The one master switch: off, no Super Admin
# route exists, its tokens are refused and its commands won't run.
SUPER_ADMIN_ENABLED=false
# Origins of the Super Admin frontend (comma-separated), allowed by CORS while enabled.
# SUPER_ADMIN_ALLOWED_ORIGINS=
# Serve the API only on this host, and/or only to these IPs/CIDRs (comma-separated).
# SUPER_ADMIN_HOST=
# SUPER_ADMIN_ALLOWED_IPS=
# SUPER_ADMIN_ALERT_EMAILS=
# Who may open Horizon and Pulse outside local (IPs/CIDRs). Empty = nobody.
# SUPER_ADMIN_DASHBOARD_IPS=
# Hosts an AI endpoint may point at although private or plain http (comma-separated).
# SUPER_ADMIN_ENDPOINT_PRIVATE_HOSTS=

# --- Model spend guard -------------------------------------------------------
# config/model_operations.php — alerts only, never blocks. US dollars of provider cost.
# MODEL_DAILY_BUDGET_USD=
# MODEL_WORKSPACE_DAILY_USD=

# =============================================================================
# APP CONNECTORS (OAUTH CLIENTS)
# =============================================================================
GOOGLE_CONNECTORS_CLIENT_ID=
GOOGLE_CONNECTORS_CLIENT_SECRET=

MICROSOFT_CONNECTORS_CLIENT_ID=
MICROSOFT_CONNECTORS_CLIENT_SECRET=

# Notion: a public integration's OAuth client id and secret (notion.so/my-integrations).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# =============================================================================
# PERSONAL ASSISTANT
# =============================================================================
# --- Branding ----------------------------------------------------------------
# The only place the assistant's name is set. See docs/ASSISTANT_BRANDING_PLAN.md.
# After changing: `php artisan config:cache && php artisan assistant:brand-refresh`.
ASSISTANT_NAME=Orb
ASSISTANT_TAGLINE="Your personal AI agent"
ASSISTANT_DESCRIPTION="Reads your apps, preps your day and handles your inbox."
ASSISTANT_EMOJI=🔮
ASSISTANT_COLOR=#7C3AED
ASSISTANT_ICON_URL=/brand/assistant/icon.svg
ASSISTANT_AVATAR_URL=/brand/assistant/icon.svg
ASSISTANT_FEATURE_DAILY=":name Daily"
ASSISTANT_FEATURE_INBOX=":name Inbox"
ASSISTANT_FEATURE_PREP=":name Prep"
ASSISTANT_FEATURE_SITUATIONS=Situations
ASSISTANT_EMAIL=orb
ASSISTANT_EMAIL_ALIASES=
ASSISTANT_INBOUND_DOMAIN=agent1o1.ai
ASSISTANT_SMS_SIGNATURE="— :name"

# --- Channels (docs/ASSISTANT_PLAN.md §7) -------------------------------------
ASSISTANT_EMAIL_INBOUND_TOKEN=
ASSISTANT_EMAIL_REQUIRE_AUTH=true
ASSISTANT_SLACK_CLIENT_ID=
ASSISTANT_SLACK_CLIENT_SECRET=
ASSISTANT_SLACK_SIGNING_SECRET=

# --- SMS (Twilio) ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ASSISTANT_SMS_FROM=

# =============================================================================
# WORKFLOW & AGENT TRIGGERS (config/triggers.php) — defaults shown
# =============================================================================
TRIGGERS_NODES_ENABLED=true

# --- Failure handling --------------------------------------------------------
TRIGGERS_FAILURES_BEFORE_DISABLE=3
TRIGGERS_SKIPS_BEFORE_DISABLE=25

# --- Webhooks ----------------------------------------------------------------
TRIGGERS_HOOK_RATE_LIMIT_PER_MINUTE=120
TRIGGERS_MAX_WEBHOOK_BODY_KB=1024
TRIGGERS_PAYLOAD_SNIPPET_CHARS=5000

# --- Scheduling & polling ----------------------------------------------------
TRIGGERS_SCHEDULE_CATCH_UP_MINUTES=10
TRIGGERS_POLL_EVERY_MINUTES=15
TRIGGERS_MIN_POLL_INTERVAL_MINUTES=1
TRIGGERS_POLL_MAX_ITEMS=100
TRIGGERS_POLL_LOCK_SECONDS=600
TRIGGERS_PUSH_RECONCILE_POLL_MINUTES=15
TRIGGERS_ADAPTIVE_POLL=true
TRIGGERS_ADAPTIVE_POLL_AFTER=6
TRIGGERS_ADAPTIVE_POLL_MAX=4
TRIGGERS_POLL_TRANSIENT_FAILURES_BEFORE_COUNT=30

# --- Run limits --------------------------------------------------------------
TRIGGERS_MAX_CONCURRENT_RUNS_PER_WORKSPACE=25
TRIGGERS_MAX_SYNC_WAIT_SECONDS=25
TRIGGERS_PROVIDER_EVENTS_RETENTION_DAYS=7

# --- Instant (push) triggers: needing setup ----------------------------------
# Slack: the connector app's signing secret, then switch on.
TRIGGERS_PUSH_SLACK_ENABLED=false
TRIGGERS_SLACK_SIGNING_SECRET=

TRIGGERS_PUSH_GMAIL_ENABLED=false
TRIGGERS_GMAIL_PUBSUB_TOPIC=
TRIGGERS_GMAIL_PUSH_TOKEN=

TRIGGERS_PUSH_GOOGLE_FORMS_ENABLED=false
TRIGGERS_GOOGLE_FORMS_PUBSUB_TOPIC=
TRIGGERS_GOOGLE_FORMS_PUSH_TOKEN=

TRIGGERS_PUSH_GOOGLE_YOUTUBE_ENABLED=false
TRIGGERS_YOUTUBE_WEBSUB_HUB=https://pubsubhubbub.appspot.com/subscribe

# Notion: the webhook verification token from the integration, then switch on.
TRIGGERS_PUSH_NOTION_ENABLED=false
TRIGGERS_NOTION_VERIFICATION_TOKEN=

# --- Instant (push) triggers: off by default ---------------------------------
TRIGGERS_PUSH_OUTLOOK_ENABLED=false
TRIGGERS_PUSH_GOOGLE_DRIVE_ENABLED=false
TRIGGERS_PUSH_GOOGLE_CALENDAR_ENABLED=false
TRIGGERS_PUSH_GOOGLE_SHEETS_ENABLED=false
TRIGGERS_PUSH_GOOGLE_DOCS_ENABLED=false
TRIGGERS_PUSH_GITHUB_ENABLED=false
TRIGGERS_PUSH_LINEAR_ENABLED=false
TRIGGERS_PUSH_JIRA_ENABLED=false

# --- Instant (push) triggers: on by default ----------------------------------
TRIGGERS_PUSH_TELEGRAM_ENABLED=true
TRIGGERS_PUSH_DISCORD_ENABLED=true
TRIGGERS_PUSH_TWILIO_ENABLED=true
TRIGGERS_PUSH_TYPEFORM_ENABLED=true
TRIGGERS_PUSH_MAILCHIMP_ENABLED=true
TRIGGERS_PUSH_KIT_ENABLED=true
TRIGGERS_PUSH_ACTIVECAMPAIGN_ENABLED=true
TRIGGERS_PUSH_RESEND_ENABLED=true
TRIGGERS_PUSH_POSTMARK_ENABLED=true
TRIGGERS_PUSH_MAILGUN_ENABLED=true
TRIGGERS_PUSH_STRIPE_ENABLED=true
TRIGGERS_PUSH_SHOPIFY_ENABLED=true
TRIGGERS_PUSH_TRELLO_ENABLED=true
TRIGGERS_PUSH_ASANA_ENABLED=true
TRIGGERS_PUSH_CLICKUP_ENABLED=true
TRIGGERS_PUSH_MONDAY_ENABLED=true
TRIGGERS_PUSH_AIRTABLE_ENABLED=true
TRIGGERS_PUSH_PIPEDRIVE_ENABLED=true
TRIGGERS_PUSH_ZOHO_ENABLED=true
TRIGGERS_PUSH_ZOHO_DESK_ENABLED=true

# --- Queues & job timeouts ---------------------------------------------------
TRIGGERS_FIRE_QUEUE=triggers-event
TRIGGERS_POLL_QUEUE=triggers-poll
TRIGGERS_AGENT_FIRE_QUEUE=ai-agent
TRIGGERS_FIRE_TIMEOUT_SECONDS=120
TRIGGERS_AGENT_FIRE_TIMEOUT_SECONDS=320
TRIGGERS_FIRE_MAX_EXCEPTIONS=5
TRIGGERS_FIRE_LOCK_RELEASE_AFTER_SECONDS=30
TRIGGERS_FIRE_LOCK_EXPIRE_AFTER_SECONDS=300

# --- Stuck-run recovery ------------------------------------------------------
TRIGGERS_STUCK_QUEUED_AFTER_MINUTES=10
TRIGGERS_STUCK_RUNNING_AFTER_MINUTES=15
TRIGGERS_STUCK_BATCH_SIZE=100

# --- Retention & pruning -----------------------------------------------------
TRIGGERS_EVENTS_RETENTION_DAYS=30
TRIGGERS_PRUNE_CHUNK=1000
TRIGGERS_PRUNE_AT=03:30
